<Project Sdk="Microsoft.NET.Sdk">
  <!-- The speed benchmarks (BenchmarkDotNet). A project of their own, since BenchmarkDotNet builds and starts a process for each case. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="ZstdSharp.Port" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Singulink.Steno\Singulink.Steno.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Singulink.Steno.Benchmarks\Corpus.cs" Link="Shared\Corpus.cs" />
    <Compile Include="..\Singulink.Steno.Benchmarks\IcuNative.cs" Link="Shared\IcuNative.cs" />
    <Compile Include="..\Singulink.Steno.Benchmarks\Workloads.cs" Link="Shared\Workloads.cs" />
    <Compile Include="..\Singulink.Steno.Tests\SampleTexts.cs" Link="Shared\SampleTexts.cs" />
  </ItemGroup>
</Project>
